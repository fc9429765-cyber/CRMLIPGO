# Variables de entorno del CRM Comercial.
#
# Copia este archivo como .env.local para desarrollo, o cárgalas en Vercel
# para el despliegue. .env.local está en .gitignore: NUNCA subir credenciales
# al repositorio.
#
# IMPORTANTE: este CRM comparte la base de datos con el sistema operativo
# (LIPgo). Las tres variables de Supabase deben apuntar al MISMO proyecto,
# porque el pedido autorizado se escribe en sus tablas.


# ── Supabase ────────────────────────────────────────────── OBLIGATORIAS ──
# Las tres salen de: Supabase → Settings → API

# URL del proyecto. Es pública (viaja al navegador).
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co

# Clave anónima. También es pública por diseño: respeta las políticas RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica

# Clave de servicio. SECRETA y sin prefijo NEXT_PUBLIC_, para que nunca
# llegue al navegador. Ignora RLS y alcanza toda la base, incluidas las
# tablas de nómina del sistema operativo. Quien la tenga puede leerlo todo.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_secreta


# ── Asistente de IA ──────────────────────────────────────────── OPCIONAL ──
# Sin ella el resto del CRM funciona; solo el asistente queda inactivo.
# La toma @ai-sdk/anthropic del entorno, sin leerla explícitamente.
ANTHROPIC_API_KEY=sk-ant-...


# ── Tareas programadas ───────────────────────────── OPCIONAL (ver abajo) ──
# Protege los endpoints de cron: sin ella responden 500 y no se ejecutan.
#
# DEBE SER DISTINTA a la del sistema operativo. Son dos despliegues, y
# compartir el secreto significa que un token filtrado dispara los crons de
# ambos. Genera una nueva, por ejemplo con:  openssl rand -hex 32
#
# Hoy el CRM no tiene crons configurados (vercel.json los trae vacíos), así
# que puede quedar pendiente hasta que se activen.
# CRON_SECRET=


# ── Notas de despliegue ────────────────────────────────────────────────────
#
# En Vercel, márcalas para los tres entornos (Production, Preview y
# Development) salvo que quieras apuntar Preview a otra base de datos.
#
# Las variables NEXT_PUBLIC_ se incrustan en el bundle al compilar: si las
# cambias, hay que volver a desplegar para que surtan efecto.

# Firma de la sesion del CRM (usuarios propios, scripts/209). Minimo 32 caracteres,
# aleatorio y DISTINTO en cada despliegue (local, Vercel). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# CRM_AUTH_SECRET=
